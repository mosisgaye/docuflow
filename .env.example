# Copier ce fichier en .env et remplir les valeurs. Ne jamais versionner .env.

# Base de données (lancée par docker compose)
POSTGRES_PASSWORD=
DATABASE_URL=postgresql+psycopg://factures:<mot-de-passe>@127.0.0.1:5434/factures

# IA d'extraction et assistant
LLM_FOURNISSEUR=openai            # openai ou gemini
OPENAI_API_KEY=
# GEMINI_API_KEY=
# LLM_MODELE=gpt-5.4-mini         # modèle d'extraction (par défaut : gpt-5.4-mini)
# AGENT_MODELE=gpt-5.4-mini       # modèle de l'assistant

# Export vers la comptabilité
# EXPORT_COMPTE_CHARGE=606000     # compte de charge par défaut
# EXPORT_WEBHOOK_URL=             # adresse du logiciel de comptabilité, si envoi direct

# Dossiers de stockage (par défaut : donnees/fichiers et donnees/exports)
# FICHIERS_DOSSIER=
# EXPORTS_DOSSIER=

# Réception des factures par mail : clés publiques Ed25519 (base64) des adaptateurs autorisés,
# séparées par des virgules. Ce ne sont pas des secrets. Sans elles, POST /reception/mail répond 503.
# RECEPTION_MAIL_CLES_PUBLIQUES=

# Connexion des connecteurs par compte (OAuth). Clé Fernet qui chiffre les jetons en base :
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# CONNECTEURS_CLE_CHIFFREMENT=
# Identifiants donnés par HubSpot (Development > MCP Connectors) :
# HUBSPOT_CLIENT_ID=
# HUBSPOT_CLIENT_SECRET=
# OAUTH_RETOUR=http://localhost:5180/api/oauth/retour
