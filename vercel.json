{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci --prefix interface",
  "buildCommand": "npm run build --prefix interface",
  "outputDirectory": "interface/dist",
  "rewrites": [
    { "source": "/api/:chemin*", "has": [{ "type": "host", "value": "demo.verifac.company" }], "destination": "https://api-demo-verifac.moussagaye.com/:chemin*" },
    { "source": "/.well-known/:chemin*", "has": [{ "type": "host", "value": "demo.verifac.company" }], "destination": "https://api-demo-verifac.moussagaye.com/.well-known/:chemin*" },
    { "source": "/api/:chemin*", "destination": "https://api-docuflow.moussagaye.com/:chemin*" },
    { "source": "/.well-known/:chemin*", "destination": "https://api-docuflow.moussagaye.com/.well-known/:chemin*" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
